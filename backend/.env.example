# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Development database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskforge?schema=public

# Separate, disposable database used by `npm test` (it is wiped on every run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskforge_test?schema=public

# At least 32 random characters (required length in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Where the React app runs; used for CORS and links in emails
FRONTEND_URL=http://localhost:5173
# Optional: extra allowed origins, comma-separated (defaults to FRONTEND_URL)
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Gmail SMTP (use an App Password). If unset in development, emails are printed to the log.
EMAIL_USER=
EMAIL_PASS=

# Brute-force protection for /auth endpoints (per client IP)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# LOG_LEVEL=debug
