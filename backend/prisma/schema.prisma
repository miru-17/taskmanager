generator client {
  provider   = "prisma-client-js"
  // Rust-free client (GA since Prisma 6.16): no native query-engine binary,
  // queries run through the @prisma/adapter-pg driver adapter. See docs/adr/0001.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String

  // Password reset — resetToken stores a SHA-256 hash of the emailed token, never the token itself
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tasks            Task[]
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      Status    @default(TODO)
  dueDate     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
