generator client {
  provider   = "prisma-client-js"
  // Rust-free client (GA since Prisma 6.16): no native query-engine binary,
  // queries run through the @prisma/adapter-pg driver adapter. See docs/adr/0001.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String // Argon2id hash (legacy bcrypt hashes are upgraded on next login)
  name            String?
  emailVerifiedAt DateTime?
  isSuperAdmin    Boolean   @default(false) // platform operator; grants NO tenant data access

  // Brute-force protection (per account; per-IP limits live in middleware)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  tokens          UserToken[]
  tasksCreated    Task[]       @relation("TaskCreator")
  invitationsSent Invitation[] @relation("InvitationInviter")
  auditLogs       AuditLog[]

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  projectsOwned      Project[]                @relation("ProjectOwner")
  tasksAssigned      Task[]                   @relation("TaskAssignee")
  watching           TaskWatcher[]
  taskActivities     TaskActivity[]
  savedViews         SavedView[]
  templatesCreated   TaskTemplate[]
  attachments        Attachment[]
  approvalsRequested ApprovalRequest[]        @relation("ApprovalRequester")
  approvalSteps      ApprovalStep[]
  comments           TaskComment[]
  reactions          CommentReaction[]
  mentions           CommentMention[]
  notifications      Notification[]           @relation("NotificationRecipient")
  notificationsSent  Notification[]           @relation("NotificationActor")
  notificationPrefs  NotificationPreference[]
  automationsCreated AutomationRule[]
}

/// One row per signed-in device. The refresh token itself is never stored, only its SHA-256.
model Session {
  id                   String    @id @default(cuid())
  userId               Int
  refreshTokenHash     String    @unique
  previousTokenHash    String?   @unique // detects reuse of a rotated-out token
  rotatedAt            DateTime?
  activeOrganizationId String?
  userAgent            String?
  ipAddress            String?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  revokedReason        String?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
}

enum UserTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use emailed tokens (stored hashed).
model UserToken {
  id        String        @id @default(cuid())
  userId    Int
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  /// Org admins can turn AI off; every AI feature then uses its rule-based fallback and nothing leaves the server
  aiEnabled Boolean @default(true)

  // ─── Plan and billing (Phase 8) ───
  plan                 Plan      @default(FREE)
  /// Pro trial: once per organization
  trialEndsAt          DateTime?
  trialUsed            Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Stripe's subscription status (active, past_due, canceled…)
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  // ─── Branding ───
  brandColor String?
  logoKey    String?
  logoMime   String?
  aiUsage    AiUsage[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships       Membership[]
  invitations       Invitation[]
  tasks             Task[]
  auditLogs         AuditLog[]
  sessions          Session[]
  teams             Team[]
  projects          Project[]
  labels            Label[]
  savedViews        SavedView[]
  templates         TaskTemplate[]
  attachments       Attachment[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  automationRules   AutomationRule[]
  automationRuns    AutomationRun[]
}

enum OrgRole {
  ORG_ADMIN
  PROJECT_MANAGER
  TEAM_LEAD
  MEMBER
  CLIENT
  VIEWER
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         Int
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String    @unique
  invitedById    Int?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

/// Append-only record of security-relevant actions.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        Int?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Work
// ─────────────────────────────────────────────────────────────────────────────

enum Status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// ORGANIZATION: every internal member can see it. PRIVATE: only project members, the project's team and org admins/PMs.
enum ProjectVisibility {
  ORGANIZATION
  PRIVATE
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER
}

enum TeamRole {
  LEAD
  MEMBER
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]

  @@unique([organizationId, name])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    Int
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id                 String             @id @default(cuid())
  organizationId     String
  key                String // short uppercase prefix for task numbers, e.g. "WEB" → WEB-12
  name               String
  description        String?
  status             ProjectStatus      @default(ACTIVE)
  visibility         ProjectVisibility  @default(ORGANIZATION)
  color              String             @default("#6366f1")
  startDate          DateTime?
  dueDate            DateTime?
  ownerId            Int?
  teamId             String?
  taskCounter        Int                @default(0)
  /// When REQUIRED, a task can only reach DONE through an approved approval request
  completionApproval ApprovalPolicyMode @default(NONE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  savedViews   SavedView[]
  customFields CustomField[]
  templates    TaskTemplate[]
  series       RecurrenceSeries[]
  automations  AutomationRule[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    Int
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id            Int       @id @default(autoincrement())
  number        Int // per-project sequence → "<KEY>-<number>"
  title         String
  description   String?
  status        Status    @default(TODO)
  priority      Priority  @default(MEDIUM)
  startDate     DateTime?
  dueDate       DateTime?
  estimateHours Float?
  actualHours   Float?
  position      Float     @default(0) // ordering within a status column

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime? // soft delete

  organizationId       String
  projectId            String
  createdById          Int?
  assigneeId           Int?
  parentId             Int?
  milestoneId          String?
  seriesId             String?
  /// The occurrence this one was generated from. Unique: one successor per occurrence, even under races.
  previousOccurrenceId Int?    @unique

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User?             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee           User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent             Task?             @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks           Task[]            @relation("Subtasks")
  milestone          Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  series             RecurrenceSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  previousOccurrence Task?             @relation("Recurrence", fields: [previousOccurrenceId], references: [id], onDelete: SetNull)
  nextOccurrence     Task?             @relation("Recurrence")

  labels         TaskLabel[]
  checklist      ChecklistItem[]
  dependsOn      TaskDependency[]  @relation("DependentTask")
  blocks         TaskDependency[]  @relation("BlockingTask")
  watchers       TaskWatcher[]
  activities     TaskActivity[]
  fieldValues    TaskFieldValue[]
  attachments    Attachment[]
  approvals      ApprovalRequest[]
  comments       TaskComment[]
  notifications  Notification[]
  automationRuns AutomationRun[]

  @@unique([projectId, number])
  @@index([organizationId, createdAt])
  @@index([projectId, status, position])
  @@index([assigneeId])
  @@index([createdById])
  @@index([seriesId])
  @@index([parentId])
  /// Due-soon and overdue sweeps, "due this week" lists
  @@index([projectId, dueDate])
}

model Label {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#64748b")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        TaskLabel[]

  @@unique([organizationId, name])
}

model TaskLabel {
  taskId  Int
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    Int
  text      String
  done      Boolean  @default(false)
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// "taskId is blocked by dependsOnId"
model TaskDependency {
  id          String   @id @default(cuid())
  taskId      Int
  dependsOnId Int
  createdAt   DateTime @default(now())

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model TaskWatcher {
  taskId    Int
  userId    Int
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// Change history: one row per create/update/move/archive…, with field-level before/after values.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    Int
  actorId   Int?
  type      String
  changes   Json?
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         Int
  projectId      String?
  name           String
  viewType       String // board | list | calendar | gantt
  filters        Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([projectId])
}

// ─── Phase 3b ────────────────────────────────────────────────────────────────

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  URL
  USER
}

/// A typed field defined per project. SELECT/MULTI_SELECT keep their choices in `options`.
model CustomField {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  type        CustomFieldType
  /// [{ "id": "opt_x", "label": "High", "color": "#ef4444" }] for select types
  options     Json?
  required    Boolean         @default(false)
  description String?
  position    Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  TaskFieldValue[]

  @@unique([projectId, name])
}

model TaskFieldValue {
  taskId    Int
  fieldId   String
  /// Typed by the field: string | number | boolean | string[] | ISO date | user id
  value     Json
  updatedAt DateTime @updatedAt

  task  Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([taskId, fieldId])
  @@index([fieldId])
}

/// A reusable task blueprint: fields, checklist and subtasks in `payload`.
model TaskTemplate {
  id             String   @id @default(cuid())
  organizationId String
  /// null = available in every project of the organization
  projectId      String?
  name           String
  description    String?
  payload        Json
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// A repeating task. The next occurrence is created when the current one is completed.
model RecurrenceSeries {
  id             String              @id @default(cuid())
  projectId      String
  frequency      RecurrenceFrequency
  interval       Int                 @default(1)
  /// 0 = Monday … 6 = Sunday (WEEKLY only)
  weekdays       Int[]
  /// Day of month the series is anchored to (MONTHLY/YEARLY); clamped to short months
  monthDay       Int?
  endsOn         DateTime?
  maxOccurrences Int?
  occurrences    Int                 @default(1)
  active         Boolean             @default(true)
  createdById    Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         Int
  uploadedById   Int?
  fileName       String
  mimeType       String
  size           Int
  /// Random, server-generated; never derived from the file name
  storageKey     String   @unique
  sha256         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([organizationId])
}

enum ApprovalPolicyMode {
  NONE
  REQUIRED
}

enum ApprovalRule {
  ANY
  ALL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  taskId        Int
  requestedById Int?
  rule          ApprovalRule   @default(ANY)
  status        ApprovalStatus @default(PENDING)
  note          String?
  decidedAt     DateTime?
  /// Set when an approved request is used to complete the task; reopening then needs a new approval
  consumedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  steps       ApprovalStep[]

  @@index([taskId, status])
}

model ApprovalStep {
  id         String           @id @default(cuid())
  requestId  String
  approverId Int
  decision   ApprovalDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?

  request  ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User            @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
  @@index([approverId, decision])
}

// ─── Phase 4: collaboration ──────────────────────────────────────────────────

/// A comment on a task. Replies are one level deep (parentId points at a top-level comment).
model TaskComment {
  id             String    @id @default(cuid())
  taskId         Int
  authorId       Int?
  parentId       String?
  /// Plain text with a tiny markdown subset; mentions are stored as @[Name](user:ID)
  body           String
  /// Set when an automation rule wrote the comment (authorId is then null)
  automationName String?
  editedAt       DateTime?
  /// Soft delete keeps the thread readable ("comment deleted") when it has replies
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    TaskComment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[]     @relation("Replies")
  reactions CommentReaction[]
  mentions  CommentMention[]

  @@index([taskId, createdAt])
  @@index([parentId])
}

model CommentReaction {
  commentId String
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
}

/// Who a comment mentions (only people who could see the task at the time)
model CommentMention {
  commentId String
  userId    Int

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

enum NotificationType {
  MENTIONED
  COMMENTED
  ASSIGNED
  STATUS_CHANGED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  DUE_SOON
  AUTOMATION
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         Int
  actorId        Int?
  type           NotificationType
  taskId         Int?
  /// Small, display-ready snapshot (task key/title, excerpt…) so the inbox needs no joins
  data           Json
  readAt         DateTime?
  emailedAt      DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, readAt, createdAt])
}

/// Per user and organization: which notification types also go by email (in-app is always on)
model NotificationPreference {
  userId         Int
  organizationId String
  emailTypes     NotificationType[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
}

// ─── Phase 6: automation ─────────────────────────────────────────────────────

enum AutomationTrigger {
  TASK_CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  COMMENT_ADDED
  DUE_SOON
  OVERDUE
}

enum AutomationRunStatus {
  /// Claimed by a worker; actions in progress
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
  LOOP_BLOCKED
}

/// "When <trigger> and <conditions>, do <actions>" for one project.
model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  enabled        Boolean           @default(true)
  trigger        AutomationTrigger
  /// Trigger options, e.g. { "to": "DONE" } for STATUS_CHANGED or { "days": 2 } for DUE_SOON
  triggerConfig  Json              @default("{}")
  /// All must hold: [{ "field": "priority", "op": "in", "value": ["HIGH","CRITICAL"] }]
  conditions     Json              @default("[]")
  /// Run in order: [{ "type": "SET_STATUS", "status": "IN_REVIEW" }]
  actions        Json
  createdById    Int?
  runCount       Int               @default(0)
  lastRunAt      DateTime?
  /// Consecutive failures; the rule switches itself off at the limit
  failureStreak  Int               @default(0)
  /// Why the system switched the rule off (failures, too many runs)
  disabledReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs         AutomationRun[]

  @@index([projectId, trigger, enabled])
}

/// One evaluation of one rule for one event. (ruleId, eventId) is unique, so a redelivered
/// event never runs a rule twice.
model AutomationRun {
  id             String              @id @default(cuid())
  ruleId         String
  organizationId String
  taskId         Int?
  eventId        String
  status         AutomationRunStatus
  /// Depth in a chain of automation-caused events (0 = caused by a person)
  depth          Int                 @default(0)
  /// Actions applied, or why it was skipped/failed
  detail         Json
  createdAt      DateTime            @default(now())

  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([ruleId, eventId])
  @@index([ruleId, createdAt])
  @@index([organizationId, createdAt])
  /// Deleting a task removes its runs
  @@index([taskId])
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

/// AI model calls per organization per calendar month (UTC), for plan limits
model AiUsage {
  organizationId String
  /// YYYY-MM
  month          String
  count          Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, month])
}

/// Stripe webhook events already handled (Stripe can deliver the same event more than once)
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
