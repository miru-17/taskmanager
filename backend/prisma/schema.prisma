generator client {
  provider   = "prisma-client-js"
  // Rust-free client (GA since Prisma 6.16): no native query-engine binary,
  // queries run through the @prisma/adapter-pg driver adapter. See docs/adr/0001.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String // Argon2id hash (legacy bcrypt hashes are upgraded on next login)
  name            String?
  emailVerifiedAt DateTime?
  isSuperAdmin    Boolean   @default(false) // platform operator; grants NO tenant data access

  // Brute-force protection (per account; per-IP limits live in middleware)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  sessions           Session[]
  tokens             UserToken[]
  tasksCreated       Task[]        @relation("TaskCreator")
  invitationsSent    Invitation[]  @relation("InvitationInviter")
  auditLogs          AuditLog[]

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  projectsOwned      Project[]      @relation("ProjectOwner")
  tasksAssigned      Task[]         @relation("TaskAssignee")
  watching           TaskWatcher[]
  taskActivities     TaskActivity[]
  savedViews         SavedView[]
}

/// One row per signed-in device. The refresh token itself is never stored, only its SHA-256.
model Session {
  id                   String    @id @default(cuid())
  userId               Int
  refreshTokenHash     String    @unique
  previousTokenHash    String?   @unique // detects reuse of a rotated-out token
  rotatedAt            DateTime?
  activeOrganizationId String?
  userAgent            String?
  ipAddress            String?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  revokedReason        String?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
}

enum UserTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use emailed tokens (stored hashed).
model UserToken {
  id        String        @id @default(cuid())
  userId    Int
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  tasks       Task[]
  auditLogs   AuditLog[]
  sessions    Session[]
  teams       Team[]
  projects    Project[]
  labels      Label[]
  savedViews  SavedView[]
}

enum OrgRole {
  ORG_ADMIN
  PROJECT_MANAGER
  TEAM_LEAD
  MEMBER
  CLIENT
  VIEWER
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         Int
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String    @unique
  invitedById    Int?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

/// Append-only record of security-relevant actions.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        Int?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Work
// ─────────────────────────────────────────────────────────────────────────────

enum Status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// ORGANIZATION: every internal member can see it. PRIVATE: only project members, the project's team and org admins/PMs.
enum ProjectVisibility {
  ORGANIZATION
  PRIVATE
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER
}

enum TeamRole {
  LEAD
  MEMBER
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]

  @@unique([organizationId, name])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    Int
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id             String            @id @default(cuid())
  organizationId String
  key            String // short uppercase prefix for task numbers, e.g. "WEB" → WEB-12
  name           String
  description    String?
  status         ProjectStatus     @default(ACTIVE)
  visibility     ProjectVisibility @default(ORGANIZATION)
  color          String            @default("#6366f1")
  startDate      DateTime?
  dueDate        DateTime?
  ownerId        Int?
  teamId         String?
  taskCounter    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  team         Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  savedViews   SavedView[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    Int
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id          Int       @id @default(autoincrement())
  number      Int // per-project sequence → "<KEY>-<number>"
  title       String
  description String?
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  estimateHours Float?
  actualHours   Float?
  position    Float     @default(0) // ordering within a status column

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime? // soft delete

  organizationId String
  projectId      String
  createdById    Int?
  assigneeId     Int?
  parentId       Int?
  milestoneId    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent       Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("Subtasks")
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  labels      TaskLabel[]
  checklist   ChecklistItem[]
  dependsOn   TaskDependency[] @relation("DependentTask")
  blocks      TaskDependency[] @relation("BlockingTask")
  watchers    TaskWatcher[]
  activities  TaskActivity[]

  @@unique([projectId, number])
  @@index([organizationId, createdAt])
  @@index([projectId, status, position])
  @@index([assigneeId])
  @@index([createdById])
  @@index([parentId])
}

model Label {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#64748b")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        TaskLabel[]

  @@unique([organizationId, name])
}

model TaskLabel {
  taskId  Int
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    Int
  text      String
  done      Boolean  @default(false)
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// "taskId is blocked by dependsOnId"
model TaskDependency {
  id          String   @id @default(cuid())
  taskId      Int
  dependsOnId Int
  createdAt   DateTime @default(now())

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model TaskWatcher {
  taskId    Int
  userId    Int
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// Change history: one row per create/update/move/archive…, with field-level before/after values.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    Int
  actorId   Int?
  type      String
  changes   Json?
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         Int
  projectId      String?
  name           String
  viewType       String // board | list | calendar | gantt
  filters        Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([projectId])
}
