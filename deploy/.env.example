# Copy to ../.env (next to docker-compose.yml). Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# At least 32 characters: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
# The address people use to open TaskForge (links in emails, CORS)
PUBLIC_URL=http://localhost:8080
# true once you serve over HTTPS
COOKIE_SECURE=false
WEB_PORT=8080

# Email (optional: without these, emails are written to the backend log instead of sent)
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your-app-password
# Without email: set true to write messages (with their sign-in/reset/invite links) to the log instead
# MAIL_LOG_CONTENT=false

# AI (optional) — Ollama on the host: AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_BASE_URL=
# AI_MODEL=llama3.2
# AI_API_KEY=

# Billing (optional, Stripe test mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
